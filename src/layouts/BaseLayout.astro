---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AlternateLinks from '../components/AlternateLinks.astro';
import { useTranslations } from '../i18n/ui';
import {
  getAlternates,
  langCodes,
  languages,
  type Lang,
} from '../i18n/utils';
import '../styles/base.css';
/*
 * El tema fosc va aquí i no a `base.css` a posta: `la-ruta` i `la-travessa`
 * carreguen `base.css` pel seu compte i han de conservar la paleta de paper.
 * Vegeu la capçalera de `theme-dark.css`.
 */
import '../styles/theme-dark.css';
// Precàrrega dels dos subconjunts llatins que sí que es faran servir sempre.
// Vite emet el mateix fitxer que referencia el CSS de les fonts, no una còpia.
import serifLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import sansLatin from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Pàgines de servei (arrel, 404) fora de l'índex dels cercadors. */
  noindex?: boolean;
  /**
   * Pàgina que no té mirall a l'altra llengua (la 404): no du ni canonical ni
   * `hreflang` ni `og:url`, i el commutador de llengua porta a la portada de
   * l'altra llengua. Cal dir-ho, perquè per a qualsevol altra pàgina
   * `getAlternates()` dona per fet que el mirall existeix.
   */
  noMirror?: boolean;
}

const { lang, title, description, noindex = false, noMirror = false } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');

// Cap URL absoluta escrita a mà: totes surten d'`Astro.site` (una línia a
// src/config/site.mjs). Si el domini canvia, aquí no es toca res.
//
// La 404 és una de sola per a les dues llengües i l'amfitrió la serveix a la URL
// que ha fallat, de manera que no té cap adreça pròpia que declarar: sense
// canonical, i `noindex` la ha de deixar fora de l'índex (Miquel, 21/10/2026).
// Abans `getAlternates()` hi traduïa el camí `/404` com si fos una pàgina, i
// la capçalera apuntava a `/ca/404/` i `/fr/404/`, que no existeixen. Preu
// assumit: el cas especial és una bandera explícita i no es dedueix del camí,
// de manera que una pàgina nova sense mirall l'ha de demanar.
const alternates = noMirror ? null : getAlternates(Astro.url);
const canonical = alternates ? new URL(alternates[lang], Astro.site) : null;
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />

    {canonical && <link rel="canonical" href={canonical} />}

    {alternates && <AlternateLinks alternates={alternates} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {
      langCodes
        .filter((code) => code !== lang)
        .map((code) => (
          <meta property="og:locale:alternate" content={languages[code].ogLocale} />
        ))
    }

    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />

    {/* Abans del primer pintat: és el que autoritza els estats inicials de
        `.reveal`. Sense JS no s'afegeix i el contingut es veu tal qual. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t('skip.content')}</a>
    <Header lang={lang} noMirror={noMirror} />
    <main id="content">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Revelació en scroll. Es reactiva a cada transició de pàgina.
      // No n'hi ha cap crida directa: `astro:page-load` arriba també a la
      // primera càrrega, i la crida directa duplicava l'observador (9/10/2026).
      // L'observador de la pàgina anterior es desconnecta en arribar a la nova:
      // abans es quedava viu sobre elements que ja no eren al document
      // (21/10/2026).
      let previous: IntersectionObserver | null = null;
      const bind = () => {
        previous?.disconnect();
        previous = null;
        document.documentElement.classList.add('js');
        const targets = document.querySelectorAll<HTMLElement>('.reveal');
        if (!targets.length) return;
        // Dues sortides cap al contingut visible abans de dependre de
        // l'observador: el text el tapa una regla de CSS i el que la desfà és
        // aquest script, de manera que qualsevol camí que no acabi en `is-in`
        // deixa la pàgina en blanc.
        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          targets.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
        );
        previous = io;
        targets.forEach((el) => io.observe(el));
      };
      document.addEventListener('astro:page-load', bind);

      // En commutar de llengua a mig document, el router substitueix la pàgina
      // i deixa el desplaçament a zero. L'àncora és el que manté la posició.
      document.addEventListener('astro:after-swap', () => {
        if (!location.hash) return;
        // `#%` o `#a[` fan llançar tant `decodeURIComponent` com `querySelector`,
        // i l'adreça la pot escriure qualsevol: una àncora mal formada no ha de
        // deixar un error sense capturar en cada canvi de llengua.
        try {
          document.querySelector(decodeURIComponent(location.hash))?.scrollIntoView({ behavior: 'instant', block: 'start' });
        } catch {}
      });
    </script>
  </body>
</html>
