---
import LangSwitcher from './LangSwitcher.astro';
import { site } from '../config/site.mjs';
import { useTranslations, type UIKey } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localize(lang);

/**
 * Àncores de la one-page. Els identificadors són estables entre llengües
 * perquè el commutador pugui conservar la secció on ets.
 */
const nav: { id: string; key: UIKey }[] = [
  { id: 'comunicacio', key: 'nav.communication' },
  { id: 'metode', key: 'nav.method' },
  { id: 'trajectoria', key: 'nav.timeline' },
  { id: 'casos', key: 'nav.cases' },
  { id: 'contacte', key: 'nav.contact' },
];
---

<header class="header">
  <div class="wrap header__inner">
    <a class="mark" href={home}>{site.name}</a>
    <nav class="nav" aria-label={t('nav.label')}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={`${home}#${item.id}`}>{t(item.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LangSwitcher lang={lang} />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 4rem;
  }

  .mark {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--w-medium);
    letter-spacing: var(--tracking-display);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav {
    margin-inline-start: auto;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: var(--w-regular);
    text-decoration: none;
    color: var(--ink-soft);
    padding-block: var(--space-2);
    position: relative;
  }

  .nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0.35rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  /* Mòbil: sense menú desplegable. La capçalera deixa de ser adherent i la
     navegació passa a una segona línia amb desplaçament horitzontal. */
  @media (max-width: 46rem) {
    .header {
      position: static;
      backdrop-filter: none;
    }

    .header__inner {
      flex-wrap: wrap;
      gap: var(--space-3);
      padding-block: var(--space-3);
    }

    .nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .nav ul {
      flex-wrap: nowrap;
      gap: var(--space-4);
    }

    .nav a {
      white-space: nowrap;
    }
  }
</style>
