---
/**
 * Primitiva de secció de la one-page: raïl d'etiqueta + columna de contingut.
 * Totes les seccions passen per aquí perquè el ritme vertical i la posició de
 * l'etiqueta no divergeixin d'una secció a l'altra.
 */
interface Props {
  /** Àncora estable, idèntica en les dues llengües. */
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  /** Fons enfonsat, per a les seccions que han de pesar igual que l'oferta. */
  sunk?: boolean;
}

/*
 * El slot `wide` entra a la graella de secció com a fill directe, no dins de la
 * columna de contingut: qui l'ompli decideix quantes columnes ocupa. És el que
 * permet que la cronologia tingui dues columnes pròpies sense perdre el raïl
 * d'etiqueta adherent a l'esquerra.
 *
 * Qui ompli el slot ha d'ocupar les dues columnes, `1 / -1` (decisió de
 * l'usuari, 28/08/2026). Abans les tres figures —oferta, cronologia, casos—
 * l'arrencaven a la columna de contingut per deixar el raïl lliure, i per tant
 * renunciaven a 12rem de columna més 3rem de separació: 15 de 74, un 20 % de
 * l'amplada reservat a una paraula de rètol que ja s'ha acabat de llegir molt
 * més amunt. El raïl continua sent columna a l'alçada del titular i de la prosa,
 * que és on serveix de rètol; a l'alçada del dibuix no reserva res. El ritme
 * vertical i l'adherència del rètol no es mouen: només canvia qui ocupa la
 * banda esquerra a les files de figura.
 */

const { id, eyebrow, title, lead, sunk = false } = Astro.props;
---

<section
  class:list={['section', { 'section--sunk': sunk }]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="wrap section-grid">
    <div class="rail">
      <p class="eyebrow">{eyebrow}</p>
    </div>
    <div class="body">
      <h2 id={`${id}-title`}>{title}</h2>
      {lead && <p class="lead section__lead">{lead}</p>}
      <slot />
    </div>
    <slot name="wide" />
  </div>
</section>

<style>
  .body > :global(h2) {
    max-width: 28ch;
  }

  .section__lead {
    margin-top: var(--space-6);
  }

  .body > :global(* + *:not(.section__lead)) {
    margin-top: var(--space-12);
  }
</style>
