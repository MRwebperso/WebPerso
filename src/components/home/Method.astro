---
/**
 * Secció de mètode (registre 2.4). Des del 12/10/2026 (D4) no es limita a dir
 * *com treballo*: promet eines pensades per al projecte del client —una
 * aplicació petita, una cadena de tractament, un producte de comunicació— i diu
 * qui en controla el resultat. Per això ha caigut l'antic «cap promesa
 * d'implantar res al client»: la frase-frontera que ho deia («no venc
 * implantacions d'IA») contradeia l'oferta (D5), i el que es compra ara és
 * l'eina feta a mida més el criteri de qui verifica el resultat i guia el
 * model.
 *
 * El relat són dos paràgrafs seguits en una sola columna de `--measure`, en lloc
 * de tres columnes: és prosa que es llegeix d'un cop, no una col·lecció
 * d'elements comparables. El fons enfonsat li dona el mateix pes visual que a la
 * línia de comunicació, sense necessitat de cap efecte. El tancament conserva el
 * filet d'accent: ja no nega res (D5), compromet una verificació.
 */
import Section from '../Section.astro';
import { home } from '../../data/home';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].method;
---

<Section id="metode" eyebrow={c.eyebrow} title={c.title} lead={c.lead} sunk>
  <div class="story">
    {
      c.story.map((paragraph, i) => (
        <p class="story__p reveal" style={`--reveal-i:${i}`}>
          {paragraph}
        </p>
      ))
    }
  </div>

  <p class="boundary">{c.boundary}</p>
</Section>

<style>
  .story {
    max-width: var(--measure);
  }

  .story__p {
    color: var(--ink-soft);
  }

  .story__p + .story__p {
    margin-top: var(--space-6);
  }

  .boundary {
    max-width: var(--measure);
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: var(--space-6);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }
</style>
