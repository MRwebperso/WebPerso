---
/**
 * Secció de mètode (registre 2.4). Des del 13/10/2026 és un discurs crític
 * sobre la IA i no una proposta (decisió de Miquel): reconeix que faig servir
 * eines d'IA, en nomena els riscos i les precaucions i acaba en el que el
 * lector hi pot guanyar. Substitueix la versió del 12/10/2026 (D4), que
 * prometia eines pensades per al projecte del client i deia qui en controlava
 * el resultat. Des del 20/10/2026 la frase-frontera diu el coneixement
 * d'especialista amb què superviso la IA, i no el compromís xifrat de D5;
 * l'antic «no venc implantacions d'IA» no ha tornat.
 *
 * El relat són dos paràgrafs seguits en una sola columna de `--measure`, en lloc
 * de tres columnes: és prosa que es llegeix d'un cop, no una col·lecció
 * d'elements comparables. El fons enfonsat li dona el mateix pes visual que a la
 * línia de comunicació, sense necessitat de cap efecte. El tancament conserva el
 * filet d'accent: ja no nega res (D5), afirma un coneixement.
 *
 * Relat i frontera comparteixen un embolcall (`.column`) la `--measure` del qual
 * es resol a la mida del cos, i no cadascun a la seva. El `ch` segueix la mida
 * de lletra de qui l'usa: la frontera, en `--step-1`, amb el seu propi
 * `max-width` sortia 130 px més ampla que el relat a 1280 px (842 contra 712).
 * L'embolcall hereta la mida del cos, la mateixa que els paràgrafs, i la
 * frontera només omple l'amplada que li toca; per això l'embolcall no ha de
 * posar mai cap `font-size`. Decisió de Miquel del 13/10/2026.
 */
import Section from '../Section.astro';
import { home } from '../../data/home';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].method;
---

<Section id="metode" eyebrow={c.eyebrow} title={c.title} lead={c.lead} sunk>
  <div class="column">
    <div class="story">
      {
        c.story.map((paragraph, i) => (
          <p class="story__p reveal" style={`--reveal-i:${i}`}>
            {paragraph}
          </p>
        ))
      }
    </div>

    <p class="boundary">{c.boundary}</p>
  </div>
</Section>

<style>
  /* Sense `font-size` a posta: el `ch` de `--measure` ha de resoldre's a la mida
     del cos (`--step-0`, heretada de `body`), la dels paràgrafs del relat. Qui
     hi posés una altra mida tornaria a separar la frontera del relat. */
  .column {
    max-width: var(--measure);
  }

  .story__p {
    color: var(--ink-soft);
  }

  .story__p + .story__p {
    margin-top: var(--space-6);
  }

  /* Dins de `.column` la frontera ja no és fill directe de `.body` i perd el
     `--space-12` que `Section` dona als germans; se li torna amb el mateix
     token. L'espai damunt de `.column` el continua posant `Section`, que ara la
     té a ella de fill directe en lloc de `.story`. */
  .boundary {
    margin-top: var(--space-12);
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: var(--space-6);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }
</style>
