---
/**
 * L'oferta. Les dues línies ja no són una llista de blocs: les pinta
 * `OfferReveal`, que les superposa i les separa amb una costura que mou el
 * lector amb el ratolí, el dit o el teclat. El contingut és el mateix de
 * `home.ts` —cap text nou— i el mode apilat de la peça és exactament el que hi
 * havia abans.
 */
import Section from '../Section.astro';
import OfferReveal from './OfferReveal.astro';
import { home } from '../../data/home';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].communication;
---

<Section id="comunicacio" eyebrow={c.eyebrow} title={c.title} lead={c.lead}>
  <OfferReveal lang={lang} slot="wide" />
</Section>
