---
import { home } from '../../data/home';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].hero;
---

<section class="hero" id="presentacio" aria-labelledby="presentacio-title">
  <div class="wrap section-grid">
    <div class="rail">
      <p class="eyebrow">{c.eyebrow}</p>
    </div>
    <div>
      <h1 id="presentacio-title">{c.title}</h1>
      <p class="lead hero__intro">{c.intro}</p>
      <p class="lead hero__intro2">{c.intro2}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--space-12), 9vh, var(--space-24)) var(--space-24);
  }

  .hero h1 {
    max-width: 26ch;
  }

  .hero__intro {
    margin-top: var(--space-8);
    color: var(--ink);
  }

  /* Un grau per sota del nucli invariant: mateixa mida, el color de lead. */
  .hero__intro2 {
    margin-top: var(--space-6);
  }
</style>
