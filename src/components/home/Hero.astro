---
/**
 * Presentació (#presentacio), reconstruïda el 12/10/2026 (D1) en coherència
 * amb l'oferta i el mètode: `h1` → primer paràgraf (color ple) → segon
 * paràgraf (color de lead). Al raïl, només el nom.
 *
 * Entre els dos paràgrafs hi havia una llista de tres serveis, cadascun
 * enllaçat a la seva secció (D7). Miquel la va treure el 20/10/2026: el lector
 * arriba a l'oferta baixant, i la presentació queda com un relat seguit.
 */
import { home } from '../../data/home';
import { homeSections, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].hero;
const { id } = homeSections.presentation;
---

<section class="hero" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap section-grid">
    <div class="rail">
      <p class="eyebrow">{c.eyebrow}</p>
    </div>
    <div>
      <h1 id={`${id}-title`}>{c.title}</h1>
      <p class="lead hero__intro">{c.intro}</p>
      <p class="lead hero__intro2">{c.intro2}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--space-12), 9vh, var(--space-24)) var(--space-24);
  }

  .hero h1 {
    max-width: 26ch;
  }

  .hero__intro {
    margin-top: var(--space-8);
    color: var(--ink);
  }

  /* Segon paràgraf: mateixa mida que el primer, el color de lead en comptes del ple. */
  .hero__intro2 {
    margin-top: var(--space-6);
  }
</style>
