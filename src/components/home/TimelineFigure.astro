---
/**
 * L'instrument de la cronologia: els tres eixos del brief (temps × territori ×
 * llengua) llegibles d'un cop d'ull i sincronitzats amb el pas que s'està
 * llegint.
 *
 * És deliberadament decoratiu (`aria-hidden`): tota la informació que hi surt
 * existeix en text a cada pas. Així la peça pot ser ambiciosa sense que
 * l'accessibilitat depengui de saber llegir un diagrama.
 *
 * Sense JS es queda en l'estat d'avui —trajectòria sencera, les sis llengües
 * de treball—, que és una lectura vàlida. La classe `is-live` és el que cedeix
 * el control als passos.
 */
import { langKeys, milestones, timeline, zoneKeys, type Zone } from '../../data/timeline';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = timeline[lang];

// ── Geometria del diagrama, en unitats de viewBox ──
const VIEW = { w: 220, h: 340 };
const LANE: Record<Zone, number> = { europa: 44, nord: 140, sud: 204 };
const FRONTIER_X = 172;
const TOP = 22;
const BOTTOM = 336;
const rowY = (i: number) => 44 + i * 56;

/*
 * Traç ortogonal: baixa pel carril d'on venia i creua a l'altura de la fita
 * nova. Les longituds acumulades es calculen aquí perquè el dibuix progressiu
 * s'aturi exactament al node de cada pas i no en un percentatge aproximat.
 */
let path = `M${LANE[milestones[0].zones[0]]},${rowY(0)}`;
let run = 0;
const offsets: number[] = [0];

for (let i = 1; i < milestones.length; i++) {
  const from = LANE[milestones[i - 1].zones[0]];
  const to = LANE[milestones[i].zones[0]];
  path += ` V${rowY(i)}`;
  run += rowY(i) - rowY(i - 1);
  if (to !== from) {
    path += ` H${to}`;
    run += Math.abs(to - from);
  }
  offsets.push(run);
}

const total = run;
const ratios = offsets.map((offset) => (offset / total).toFixed(4)).join(',');
const rows = milestones.map((_, i) => rowY(i)).join(',');

/** Ponts entre carrils: les fites que ocupen dues zones alhora. */
const spans = milestones
  .map((milestone, i) => ({ milestone, i }))
  .filter(({ milestone }) => milestone.zones.length > 1)
  .map(({ milestone, i }) => {
    const xs = milestone.zones.map((zone) => LANE[zone]);
    return { i, y: rowY(i), from: Math.min(...xs), to: Math.max(...xs) };
  });

const last = milestones[milestones.length - 1];
const lastCopy = c.milestones[c.milestones.length - 1];
---

<figure class="figure" data-timeline-figure aria-hidden="true">
  <p class="figure__year nums">
    <span data-year>{last.year}</span>
    <span class="figure__suffix" data-year-suffix>{lastCopy.yearSuffix ?? ''}</span>
  </p>
  <p class="figure__zone ui" data-zone>{lastCopy.zoneLabel}</p>

  <div class="figure__body">
    <svg
      class="diagram"
      viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
      data-timeline-svg
      data-rows={rows}
      style={`--total:${total}`}
    >
      <rect
        class="diagram__far"
        x={FRONTIER_X}
        y={TOP}
        width={VIEW.w - FRONTIER_X}
        height={BOTTOM - TOP}
      />

      {
        zoneKeys.map((zone) => (
          <line class="diagram__lane" x1={LANE[zone]} x2={LANE[zone]} y1={TOP} y2={BOTTOM} />
        ))
      }

      <line class="diagram__frontier" x1={FRONTIER_X} x2={FRONTIER_X} y1={TOP} y2={BOTTOM} />
      <text
        class="diagram__frontier-label"
        x={FRONTIER_X - 8}
        y={rowY(1)}
        transform={`rotate(-90 ${FRONTIER_X - 8} ${rowY(1)})`}>{c.frontier}</text
      >

      {zoneKeys.map((zone) => <text class="diagram__zone" x={LANE[zone]} y={14}>{c.zoneNames[zone]}</text>)}

      <line class="diagram__row" x1={8} x2={VIEW.w - 8} y1={0} y2={0} />

      <path class="diagram__ghost" d={path} />
      <path class="diagram__trace" d={path} data-trace data-ratios={ratios} />

      {
        spans.map((span) => (
          <line
            class="diagram__span"
            data-node={span.i}
            x1={span.from}
            x2={span.to}
            y1={span.y}
            y2={span.y}
          />
        ))
      }

      {
        milestones.map((milestone, i) =>
          milestone.zones.map((zone, at) => (
            <circle
              class:list={['diagram__node', { 'diagram__node--tied': at > 0 }]}
              data-node={i}
              cx={LANE[zone]}
              cy={rowY(i)}
              r={at > 0 ? 3.2 : 4.4}
            />
          )),
        )
      }
    </svg>

    <div class="langs">
      <ul class="langs__list ui">
        {
          langKeys.map((key) => (
            <li class="lang" data-lang={key} data-state={last.langs[key]}>
              <span class="pip" />
              <span class="lang__name">{c.langNames[key]}</span>
            </li>
          ))
        }
      </ul>

      <p class="langs__key ui">
        <span class="langs__key-item" data-state="1"><span class="pip" />{c.stateLabels.acquired}</span>
        <span class="langs__key-item" data-state="2"><span class="pip" />{c.stateLabels.working}</span>
      </p>
    </div>
  </div>

  <figcaption class="figure__note ui">{c.figureNote}</figcaption>
</figure>

<style>
  .figure {
    margin: 0;
    position: sticky;
    top: 5.5rem;
  }

  .figure__year {
    font-size: var(--step-4);
    line-height: 1;
    font-weight: var(--w-light);
    color: var(--ink);
  }

  .figure__suffix {
    font-size: var(--step-0);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .figure__zone {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    min-height: 2.4em;
  }

  .figure__body {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 7.5rem);
    gap: var(--space-4);
    align-items: start;
  }

  .figure__note {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 0.78rem;
    text-wrap: pretty;
  }

  /* ── Eix territori ── */
  .diagram {
    width: 100%;
    overflow: visible;
    font-family: var(--font-ui);
  }

  .diagram__far {
    fill: var(--accent-soft);
    opacity: 0.6;
  }

  .diagram__lane {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .diagram__frontier {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0.6;
  }

  .diagram__frontier-label {
    fill: var(--accent);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-anchor: middle;
  }

  .diagram__zone {
    fill: var(--ink-faint);
    font-size: 13px;
    font-weight: var(--w-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-anchor: middle;
  }

  /* Filera activa: l'únic element que es mou de manera contínua amb el scroll. */
  .diagram__row {
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0;
    transform: translateY(calc(var(--row-y, 0) * 1px));
    transition:
      transform var(--dur-slow) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }

  .diagram__ghost,
  .diagram__trace {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .diagram__ghost {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .diagram__trace {
    --draw: 1;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-dasharray: calc(var(--total) * 1px);
    stroke-dashoffset: calc(var(--total) * (1 - var(--draw)) * 1px);
    transition: stroke-dashoffset var(--dur-slow) var(--ease-out);
  }

  .diagram__span {
    stroke: var(--ink);
    stroke-width: 1.6;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  /* L'anella de paper separa el node del traç que hi passa per sota. */
  .diagram__node {
    fill: var(--ink);
    stroke: var(--paper);
    stroke-width: 1.6;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill var(--dur-base) var(--ease-out),
      stroke var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .diagram__node--tied {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .figure.is-live .diagram__row {
    opacity: 0.5;
  }

  .figure.is-live .diagram__node[data-state='future'] {
    fill: var(--paper);
    stroke: var(--rule);
    stroke-width: 1.2;
  }

  .figure.is-live .diagram__node[data-state='past'] {
    fill: var(--ink-faint);
    stroke: var(--paper);
  }

  .figure.is-live .diagram__node[data-state='current'] {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 2;
    transform: scale(1.4);
  }

  .figure.is-live .diagram__node--tied[data-state='current'] {
    fill: var(--paper);
    stroke: var(--accent);
    stroke-width: 1.8;
  }

  .figure.is-live .diagram__span[data-state='future'] {
    opacity: 0;
  }

  /* ── Eix llengua ── */
  .langs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-faint);
    transition: color var(--dur-base) var(--ease-out);
  }

  .lang[data-state='2'] {
    color: var(--ink);
  }

  .lang__name {
    font-variant: small-caps;
    letter-spacing: 0.02em;
  }

  /*
   * Tres formes, no tres colors: res / anella / disc. Així l'estat es distingeix
   * sense dependre del color, que en un diagrama petit és el primer que es perd.
   */
  .pip {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid transparent;
    background: transparent;
    transition:
      background var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  [data-state='0'] .pip {
    border-color: var(--rule);
    border-style: dotted;
  }

  [data-state='1'] .pip {
    border-color: var(--ink-faint);
  }

  [data-state='2'] .pip {
    background: var(--accent);
    border-color: var(--accent);
  }

  .langs__key {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    display: grid;
    gap: var(--space-1);
    color: var(--ink-faint);
    font-size: 0.72rem;
  }

  .langs__key-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
