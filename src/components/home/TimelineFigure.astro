  return { d: arcD(barcelonaPoint, dest, 0.18), dest };
});

// ── Pandèmia (fita 4): Suïssa → Vallespir → Alemanya → Suïssa, i algun tram
// cap a Barcelona («el procés d'establir-se»). L'ordre és el de l'espec, no
// alfabètic ni geogràfic. ──
const oscillationArcs = [
  { d: arcD(chPoint, vaPoint, 0.16), secondary: false },
  { d: arcD(vaPoint, dePoint, 0.16), secondary: false },
  { d: arcD(dePoint, chPoint, 0.16), secondary: false },
  { d: arcD(chPoint, barcelonaPoint, 0.14), secondary: true },
];

/**
 * Fita final: el ram de la feina d'ara. Surt de Prats de Molló cap a les
 * ciutats on hi ha els encàrrecs i els interlocutors, als dos costats de la
 * frontera —el mateix vocabulari que «Projectes europeus», però a l'escala de
 * casa: allà eren capitals europees, aquí són cinc ciutats a dues hores.
 */
const CATALAN_DESTS: [number, number][] = [
  [2.895, 42.698], // Perpinyà
  [2.422, 42.617], // Prada
  [2.824, 41.983], // Girona
  [2.174, 41.387], // Barcelona
  [0.626, 41.617], // Lleida
];
const catalanArcs = CATALAN_DESTS.map(([lon, lat]) => {
  const dest = project(lon, lat);
  return { d: arcD(vaPoint, dest, 0.16), dest };
});

/** La «càmera»: mateix punt de vista per a les fites 0–2, s'allunya a
 * «Projectes europeus» (es vegin els països veïns), es desplaça cap al nord a
 * la Pandèmia, s'acosta a Catalunya al final. Un sol transform per fita —
 * `activate()` només el llegeix. */
function cameraFor(focus: Point, scale: number) {
  return { scale, tx: VIEW.w / 2 - scale * focus.x, ty: VIEW.h / 2 - scale * focus.y };
}
const westFocus: Point = {
  x: (cevenesPoint.x + portugalPoint.x + barcelonaPoint.x) / 3,
  y: (cevenesPoint.y + portugalPoint.y + barcelonaPoint.y) / 3,
};
const europeFocus = project((LON_MIN + LON_MAX) / 2, (LAT_MIN + LAT_MAX) / 2);
// Nomes Suïssa i Alemanya: Vallespir hi entraria massa al sud i tornaria a
// abaixar la càmera just quan cal pujar-la.
const oscillationFocus: Point = { x: (chPoint.x + dePoint.x) / 2, y: (chPoint.y + dePoint.y) / 2 };

/**
 * A la fita final el quadre és Catalunya sencera i prou: l'enquadrament surt
 * del contorn mateix, no d'un nombre triat a ull, així que si un dia el
 * contorn canvia la càmera l'hi segueix. Abans hi havia el punt mitjà entre
 * Barcelona i el Vallespir a 2,4×, i el país no hi cabia ni s'hi reconeixia.
 */
const catBox = catalanCoastPoints.reduce(
  (box, p) => ({
    minX: Math.min(box.minX, p.x),
    maxX: Math.max(box.maxX, p.x),
    minY: Math.min(box.minY, p.y),
    maxY: Math.max(box.maxY, p.y),
  }),
  { minX: Infinity, maxX: -Infinity, minY: Infinity, maxY: -Infinity },
);
const CAT_PAD = 26;
const catalanFocus: Point = { x: (catBox.minX + catBox.maxX) / 2, y: (catBox.minY + catBox.maxY) / 2 };
const catalanScale = Math.min(
  (VIEW.w - CAT_PAD * 2) / (catBox.maxX - catBox.minX),
  (VIEW.h - CAT_PAD * 2) / (catBox.maxY - catBox.minY),
);

// La primera fita és un únic punt fosc, no un territori: la càmera hi entra
// de prop, com a la fita final, i s'allunya a «Évora i Lisboa» per fer lloc a
// la segona.
const CAMERA = [
  cameraFor(cevenesPoint, 2.4),
  cameraFor(westFocus, 1.3),
  cameraFor(westFocus, 1.3),
  cameraFor(europeFocus, 0.75),
  cameraFor(oscillationFocus, 0.85),
  cameraFor(catalanFocus, catalanScale),
];
const cameraAttr = CAMERA.map((cam) => `${cam.scale}:${cam.tx.toFixed(1)}:${cam.ty.toFixed(1)}`).join(',');

const last = milestones[milestones.length - 1];
const lastCopy = c.milestones[c.milestones.length - 1];
---

<figure class="figure" data-timeline-figure aria-hidden="true">
  <p class="figure__year nums">
    <span data-year>{last.year}</span>
    <span class="figure__suffix" data-year-suffix>{lastCopy.yearSuffix ?? ''}</span>
  </p>
  <p class="figure__zone ui" data-zone>{lastCopy.zoneLabel}</p>

  <div class="figure__body">
    <svg class="figure__map" viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} data-timeline-svg data-camera={cameraAttr}>
      <defs>
        {/*
          La trama es mesura en unitats del mapa, així que la càmera l'amplia
          amb tota la resta: a 6× quedaven quatre ratlles escampades per tot el
          quadre, que és justament el que no ha de semblar. `activate()` hi
          escriu `patternTransform` amb l'escala inversa, de manera que el pas
          de la trama a la pantalla és el mateix a totes les fites. La ratlla
          hi va per dins, i per tant s'encongeix amb la casella: la densitat es
          manté sola.
        */}
        <pattern
          id="timeline-hatch"
          width="6"
          height="6"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(38)"
          data-timeline-hatch
        >
          <line x1="0" y1="0" x2="0" y2="6" class="figure__hatch-line" />
        </pattern>
      </defs>

      <g class="figure__world">
        <g class="figure__countries">
          {countryPaths.map((d) => <path class="figure__land" d={d} fill="url(#timeline-hatch)" />)}
          {
            countryPaths.map((d) => (
              <path class="figure__land-outline" d={d} vector-effect="non-scaling-stroke" />
            ))
          }
        </g>

        <path class="figure__frontier" d={frontierD} />

        <g class="figure__oscillation" data-node="4">
          {
            oscillationArcs.map((arc, i) => (
              <path
                class:list={['figure__oscillation-arc', { 'figure__oscillation-arc--secondary': arc.secondary }]}
                d={arc.d}
                style={`--reveal-delay:${(i * 0.35).toFixed(2)}s`}
                vector-effect="non-scaling-stroke"
              />
            ))
          }
          <circle
            class="figure__oscillation-dot"
            cx={dePoint.x}
            cy={dePoint.y}
            r="3"
            style="--reveal-delay:0.35s"
            vector-effect="non-scaling-stroke"
          />
        </g>

        <g class="figure__fan" data-node="3">
          {
            fanArcs.map((arc, i) => (
              <>
                <path
                  class="figure__fan-arc"
                  d={arc.d}
                  style={`--reveal-delay:${(i * 0.12).toFixed(2)}s`}
                  vector-effect="non-scaling-stroke"
                />
                <circle
                  class="figure__fan-dot"
                  cx={arc.dest.x}
                  cy={arc.dest.y}
                  r="2"
                  style={`--reveal-delay:${(i * 0.12).toFixed(2)}s`}
                  vector-effect="non-scaling-stroke"
                />
              </>
            ))
          }
        </g>

        <g class="figure__catalonia" data-node="5">
          <path
            class="figure__catalonia-land"
            d={catalanCoastD}
            fill="url(#timeline-hatch)"
            style="--reveal-delay:0s"
          />
          <path class="figure__catalonia-land-outline" d={catalanCoastD} style="--reveal-delay:0s" vector-effect="non-scaling-stroke" />
          {
            catalanArcs.map((arc, i) => (
              <>
                <path
                  class="figure__catalonia-arc"
                  d={arc.d}
                  style={`--reveal-delay:${(0.3 + i * 0.12).toFixed(2)}s`}
                  vector-effect="non-scaling-stroke"
                />
                <circle
                  class="figure__catalonia-dot"
                  cx={arc.dest.x}
                  cy={arc.dest.y}
                  r="2"
                  style={`--reveal-delay:${(0.3 + i * 0.12).toFixed(2)}s`}
                  vector-effect="non-scaling-stroke"
                />
              </>
            ))
          }
        </g>

        {
          segments.map((seg) => (
            <path
              class="figure__route-segment"
              data-node={seg.nodeIndex}
              d={seg.d}
              pathLength="1"
            />
          ))
        }

        {
          milestones.map((_, i) => (
            <circle
              class="figure__node"
              data-node={i}
              cx={anchors[i].x}
              cy={anchors[i].y}
              r="4.2"
              vector-effect="non-scaling-stroke"
            />
          ))
        }
      </g>
    </svg>

    <div class="langs">
      <ul class="langs__list ui">
        {
          langKeys.map((key) => (
            <li class="lang" data-lang={key} data-state={last.langs[key]}>
              <span class="pip" />
              <span class="lang__name">{c.langNames[key]}</span>
            </li>
          ))
        }
      </ul>

      <p class="langs__key ui">
        <span class="langs__key-item" data-state="1"><span class="pip" />{c.stateLabels.learning}</span>
        <span class="langs__key-item" data-state="2"><span class="pip" />{c.stateLabels.acquired}</span>
      </p>
    </div>
  </div>

  <figcaption class="figure__note ui">{c.figureNote}</figcaption>
</figure>

<style>
  .figure {
    margin: 0;
    position: sticky;
    top: 5.5rem;
  }

  .figure__year {
    font-size: var(--step-4);
    line-height: 1;
    font-weight: var(--w-light);
    color: var(--ink);
  }

  .figure__suffix {
    font-size: var(--step-0);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .figure__zone {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    min-height: 2.4em;
  }

  .figure__body {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 7.5rem);
    gap: var(--space-4);
    align-items: start;
  }

  .figure__note {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 0.78rem;
    text-wrap: pretty;
  }

  /* ── Eix territori: el mapa. `overflow: hidden` a propòsit —la càmera
     retalla a la vora del quadre, no vessa per la pàgina. ── */
  .figure__map {
    width: 100%;
    overflow: hidden;
    font-family: var(--font-ui);
  }

  .figure__hatch-line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .figure__world {
    transform-origin: 0 0;
    transform: translate(calc(var(--cam-x, 0) * 1px), calc(var(--cam-y, 0) * 1px)) scale(var(--cam-scale, 1));
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .figure__land {
    stroke: none;
    opacity: 0.5;
  }

  .figure__land-outline {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
  }

  /*
   * La frontera i els trams del viatge són els dos únics traços discontinus, i
   * per això els dos únics que NO poden dur `vector-effect: non-scaling-stroke`:
   * amb l'efecte activat el navegador mesura el patró de guions en píxels de
   * pantalla mentre la longitud de la corba es compta en unitats del mapa, i a
   * càmera 2× només se'n dibuixa la meitat. És d'aquí que venia el tram que no
   * arribava mai al punt de destinació. Sense l'efecte, la mesura torna a ser
   * la mateixa als dos costats i el gruix es compensa a mà dividint per
   * `--cam-scale`, que és el que feia l'efecte i l'únic que en volíem.
   */
  .figure__frontier {
    fill: none;
    stroke: var(--accent);
    stroke-width: calc(1 / var(--cam-scale, 1));
    stroke-dasharray: calc(2 / var(--cam-scale, 1)) calc(3 / var(--cam-scale, 1));
    opacity: 0.65;
    transition: stroke-width var(--dur-slow) var(--ease-out);
  }

  /*
   * Cada tram és el seu propi traç, sempre a tinta plena — només la longitud
   * dibuixada (`stroke-dashoffset`) anima; el color no, perquè un tram no ha
   * de veure's pàl·lid mentre creix (era el problema d'abans). `pathLength="1"`
   * al marcatge fa que 1 sigui exactament tota la corba.
   *
   * Sense JS: tot dibuixat, com si ja s'hagués fet el viatge. Amb JS: només el
   * tram que s'acaba de recórrer existeix. Els anteriors no s'apaguen, es
   * desfan —el mapa no acumula el recorregut sencer, ensenya el salt d'ara.
   * L'opacitat cau de cop just quan s'ha acabat de desfer: amb `linecap: round`,
   * un guió de llargada zero encara pinta un punt rodó a l'inici de la corba, i
   * era aquest el bocí de tram que quedava penjat al mapa.
   */
  .figure__route-segment {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke: var(--ink);
    stroke-width: calc(1.8 / var(--cam-scale, 1));
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 1;
    transition:
      stroke-dashoffset var(--dur-slow) var(--ease-out),
      stroke-width var(--dur-slow) var(--ease-out),
      opacity 0s linear var(--dur-slow);
  }

  .figure.is-live .figure__route-segment {
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .figure.is-live .figure__route-segment[data-state='current'] {
    stroke-dashoffset: 0;
    opacity: 1;
    transition:
      stroke-dashoffset var(--dur-slow) var(--ease-out),
      stroke-width var(--dur-slow) var(--ease-out),
      opacity 0s linear;
  }

  /*
   * El node comença blanc —l'estat per defecte, abans que `activate()` hi
   * toqui res— fins i tot a la primera fita: només s'enfosqueix quan hi posa
   * «current», i amb un retard d'un `--dur-slow` perquè s'encengui just quan
   * el tram que hi arriba acaba de dibuixar-se, no alhora. L'anella de paper
   * el separa del traç de sota.
   */
  /*
   * Els punts es dibuixen en unitats del mapa, així que la càmera també els
   * amplia: a la fita final, amb la càmera a fons sobre Catalunya, el punt
   * fosc tapava mig país. Cada punt es divideix, doncs, per `--cam-scale` i
   * queda de la mateixa mida a la pantalla a totes les fites, tant si el mapa
   * ensenya Europa sencera com una vall.
   */
  .figure__node,
  .figure__fan-dot,
  .figure__oscillation-dot,
  .figure__catalonia-dot {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(calc(1 / var(--cam-scale, 1)));
  }

  .figure__node {
    fill: var(--paper);
    stroke: var(--rule);
    stroke-width: 1.2;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill var(--dur-base) var(--ease-out),
      stroke var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }

  /*
   * El mapa no du el compte del viatge sencer: en tot moment hi ha com a molt
   * dos punts, el d'ara i el d'on es venia, i el tram que els uneix. Les fites
   * encara no caminades («future») no hi són, i les que ja han quedat dues
   * enrere («past») se'n van —el punt de sortida desapareix quan el traç
   * següent ja ha nascut, no s'hi acumula.
   */
  .figure.is-live .figure__node[data-state='future'],
  .figure.is-live .figure__node[data-state='past'] {
    opacity: 0;
    fill: var(--paper);
    stroke: var(--rule);
    stroke-width: 1.2;
  }

  .figure.is-live .figure__node[data-state='prev'] {
    fill: var(--ink-faint);
    stroke: var(--paper);
  }

  .figure.is-live .figure__node[data-state='current'] {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 2;
    transform: scale(calc(1.4 / var(--cam-scale, 1)));
    transition-delay: var(--dur-slow);
  }

  /* ── Rams decoratius: «Projectes europeus» (moltes destinacions), la
     Pandèmia (anada i tornada) i la fita final (Catalunya). Sense JS es veuen
     sencers. Amb JS, cada element hi entra en el seu propi moment
     (`--reveal-delay`): no apareixen tots alhora. ── */
  .figure__fan,
  .figure__oscillation,
  .figure__catalonia {
    opacity: 1;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  /* Els rams no sobreviuen la seva fita. Quedar-se atenuats era la manera de
     no perdre'ls del tot, però a l'última fita hi arribaven totes les anades i
     tornades de la Pandèmia i el mapa hi tornava a acumular recorregut. La
     mateixa regla que els punts, doncs: només el d'ara. */
  .figure.is-live .figure__fan:not([data-state='current']),
  .figure.is-live .figure__oscillation:not([data-state='current']),
  .figure.is-live .figure__catalonia:not([data-state='current']) {
    opacity: 0;
  }

  .figure__fan-arc,
  .figure__fan-dot,
  .figure__oscillation-arc,
  .figure__catalonia-arc,
  .figure__catalonia-land,
  .figure__catalonia-land-outline,
  .figure__catalonia-dot {
    opacity: 1;
    transition: opacity var(--dur-slow) var(--ease-out);
    transition-delay: 0s;
  }

  .figure.is-live .figure__fan:not([data-state='current']) .figure__fan-arc,
  .figure.is-live .figure__fan:not([data-state='current']) .figure__fan-dot,
  .figure.is-live .figure__oscillation:not([data-state='current']) .figure__oscillation-arc,
  .figure.is-live .figure__catalonia:not([data-state='current']) .figure__catalonia-arc,
  .figure.is-live .figure__catalonia:not([data-state='current']) .figure__catalonia-land,
  .figure.is-live .figure__catalonia:not([data-state='current']) .figure__catalonia-land-outline,
  .figure.is-live .figure__catalonia:not([data-state='current']) .figure__catalonia-dot {
    opacity: 0;
    transition-delay: 0s;
  }

  .figure.is-live .figure__fan[data-state='current'] .figure__fan-arc,
  .figure.is-live .figure__fan[data-state='current'] .figure__fan-dot,
  .figure.is-live .figure__oscillation[data-state='current'] .figure__oscillation-arc,
  .figure.is-live .figure__catalonia[data-state='current'] .figure__catalonia-arc,
  .figure.is-live .figure__catalonia[data-state='current'] .figure__catalonia-land,
  .figure.is-live .figure__catalonia[data-state='current'] .figure__catalonia-land-outline,
  .figure.is-live .figure__catalonia[data-state='current'] .figure__catalonia-dot {
    opacity: 1;
    transition-delay: var(--reveal-delay, 0s);
  }

  .figure__fan-arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.7;
  }

  .figure__fan-dot {
    fill: var(--paper);
    stroke: var(--ink-faint);
    stroke-width: 1;
  }

  .figure__oscillation-arc {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 0.9;
  }

  .figure__oscillation-arc--secondary {
    stroke: var(--ink-faint);
    stroke-width: 0.7;
    stroke-dasharray: 1.5 2;
  }

  /*
   * El punt d'Alemanya s'encén a part del seu propi ram: apareix (opacitat)
   * amb la resta de l'oscil·lació, però només s'enfosqueix («fill»/«stroke»)
   * mig segon més tard — quan el tram Suïssa→Vallespir→Alemanya ja hi hauria
   * arribat, no a l'instant que el ram sencer es fa visible.
   */
  .figure__oscillation-dot {
    opacity: 1;
    fill: var(--paper);
    stroke: var(--ink-faint);
    stroke-width: 1.2;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      fill var(--dur-slow) var(--ease-out),
      stroke var(--dur-slow) var(--ease-out);
    transition-delay: 0s;
  }

  .figure.is-live .figure__oscillation:not([data-state='current']) .figure__oscillation-dot {
    opacity: 0;
  }

  .figure.is-live .figure__oscillation[data-state='current'] .figure__oscillation-dot {
    opacity: 1;
    fill: var(--accent);
    stroke: var(--accent);
    transition:
      opacity var(--dur-slow) var(--ease-out) var(--reveal-delay, 0s),
      fill var(--dur-slow) var(--ease-out) 0.7s,
      stroke var(--dur-slow) var(--ease-out) 0.7s;
  }

  .figure__catalonia-land {
    stroke: none;
    opacity: 0.5;
  }

  /* A la darrera fita aquest contorn és el mapa, no un afegit: ha de guanyar
     les vores de país que hi passen per sota —la frontera d'estat el travessa
     pel mig i el contorn no s'hi ha d'aturar. */
  .figure__catalonia-land-outline {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.4;
  }

  .figure__catalonia-arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
  }

  .figure__catalonia-dot {
    fill: var(--paper);
    stroke: var(--ink-faint);
    stroke-width: 1;
  }

  /*
   * Mentre `is-priming` hi és (només a l'arrencada, un instant), cap
   * d'aquests elements no anima el pas d'amagat a visible: la primera
   * activació aplica l'estat real de cop. Els punts que ja neixen «future» hi
   * són inclosos —si no, es veurien un instant abans d'esvair-se— però només
   * aquest estat: el punt «current» hi queda fora expressament, perquè el
   * primer sí que s'ha de veure blanc i enfosquir-se amb calma, no aparèixer
   * ja fosc. Els «pips» de llengua hi són pel mateix motiu que els trams: el
   * marcatge estàtic els dibuixa amb les dades de l'última fita (Vallespir,
   * totes adquirides), i sense això es veurien un instant totes plenes abans
   * de buidar-se cap a l'estat real de la primera fita mostrada.
   */
  .figure.is-priming .figure__route-segment,
  .figure.is-priming .figure__node[data-state='future'],
  .figure.is-priming .figure__node[data-state='past'],
  .figure.is-priming .figure__fan,
  .figure.is-priming .figure__oscillation,
  .figure.is-priming .figure__catalonia,
  .figure.is-priming .figure__fan-arc,
  .figure.is-priming .figure__fan-dot,
  .figure.is-priming .figure__oscillation-arc,
  .figure.is-priming .figure__oscillation-dot,
  .figure.is-priming .figure__catalonia-arc,
