---
/**
 * Rutes mirall dels casos, costat francès: `/fr/cas/<id>/`. Vegeu el bessó
 * català a `src/pages/ca/casos/[case].astro`.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseContent from '../../../components/CaseContent.astro';
import { site } from '../../../config/site.mjs';
import { getCase, getCases } from '../../../data/cases';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((item) => ({
    params: { case: item.id },
    props: { id: item.id },
  }));
}

interface Props {
  id: string;
}

const { id } = Astro.props;
const copy = (await getCase(id)).copy.fr;
---

<BaseLayout lang="fr" title={`${copy.title} — ${site.name}`} description={copy.summary}>
  <CaseContent lang="fr" id={id} />
</BaseLayout>
