---
/**
 * Rutes mirall dels casos, costat francès: `/fr/cas/<id>/`. Vegeu el bessó
 * català a `src/pages/ca/casos/[case].astro`.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseContent from '../../../components/CaseContent.astro';
import { site } from '../../../config/site.mjs';
import { getCaseRoutes, type CaseRouteProps } from '../../../data/cases';

export async function getStaticPaths() {
  return getCaseRoutes();
}

type Props = CaseRouteProps;

const { record, prev, next } = Astro.props;
const copy = record.copy.fr;
---

<BaseLayout lang="fr" title={`${copy.title} — ${site.name}`} description={copy.summary}>
  <CaseContent lang="fr" record={record} prev={prev} next={next} />
</BaseLayout>
