---
/**
 * «Targetes» v5 — prototip llencable: carril lineal, tres categories.
 *
 * Que canvia respecte de /targetes-4/, tot per encarrec de l'usuari
 * (27/08/2026):
 *
 * 1. Fora el bucle. El carril te un principi i un final: mes recent a
 *    l'esquerra, mes antic a la dreta, i s'acaba. Les fletxes queden centrades
 *    sota la cinta i s'apaguen quan ja no hi ha on anar —un carril finit ha de
 *    dir on s'acaba, i era justament aixo el que el cicle amagava.
 *
 * 2. Tres categories i prou: Codi i IA, Comunicacio, Recerca. «Marca» i
 *    «Territori» eren families d'una sola fitxa, i una categoria que no agrupa
 *    res no classifica: etiqueta.
 *
 * 3. El boto ja respon a tota la seva superficie. Era un error de pintat, no
 *    d'arees: `.repos` es queda amb `opacity: 0` i aixo li obre context
 *    d'apilament, mentre que `.detall` obert (opacitat 1, `transform: none`)
 *    no en te cap. Per l'ordre de pintat de CSS, el context s'imprimeix per
 *    damunt del bloc en flux, o sigui que el bloc invisible tapava el boto.
 *    Comprovat amb `elementFromPoint`: al centre del boto responia `familia`.
 *    Es corregeix donant `position: relative; z-index: 1` al detall i treient
 *    els esdeveniments de punter del repos, que no en necessita cap.
 *
 * Ruta fora de la navegacio i de l'i18n, catala nomes, `noindex`, per
 * esborrar. Carrega `theme-dark.css` perque la seccio de casos es fosca.
 */
import '../styles/base.css';
import '../styles/theme-dark.css';

type Targeta = {
  slug: string;
  categoria: string;
  periode: string;
  titol: string;
  subtitol: string;
  competencies: string[];
  entitats: { sigla: string; nom: string }[];
};

/* Del mes recent al mes antic, per any de tancament: el carril es llegeix
   d'esquerra a dreta com un retroces en el temps. */
const targetes: Targeta[] = [
  {
    slug: 'que-fas',
    categoria: 'Codi i IA',
    periode: '2026 — avui',
    titol: '«Què fas?»',
    subtitol: 'L’agenda cultural de Catalunya Nord',
    competencies: ['Web sense framework', 'Extracció amb IA', 'Curadoria editorial'],
    entitats: [{ sigla: 'CLM', nom: 'Cultures, Llengües i Memòries del Vallespir' }],
  },
  {
    slug: 'mar-i-muntanya',
    categoria: 'Comunicació',
    periode: '2026',
    titol: 'Mar i Muntanya, a Taula!',
    subtitol: 'Marca transfronterera i web bilingüe',
    competencies: ['Identitat de marca', 'Web amb CMS', 'Redacció de dossiers'],
    entitats: [
      { sigla: 'CLM', nom: 'Cultures, Llengües i Memòries del Vallespir' },
      { sigla: 'ST', nom: 'Som Turisme (Alt Empordà)' },
    ],
  },
  {
    slug: 'agencia-atractivitat',
    categoria: 'Comunicació',
    periode: '2023 — 2025',
    titol: 'Oficina de Turisme de Prats',
    subtitol: 'Una destinació de frontera',
    competencies: ['Estratègia de destinació', 'Disseny de visuals', 'Edició de xarxes'],
    entitats: [
      { sigla: 'OT', nom: 'Oficina de Turisme de Prats de Molló' },
      { sigla: 'AA', nom: 'Agència d’Atractivitat de l’Alt Vallespir' },
    ],
  },
  {
    slug: 'grecs-oacu',
    categoria: 'Recerca',
    periode: '2020 — 2024',
    titol: 'Recerca a la UB',
    subtitol: 'Recerca etnogràfica a Suïssa',
    competencies: ['Etnografia de camp', 'Escriptura acadèmica', 'Treball en grup'],
    entitats: [
      { sigla: 'UB', nom: 'Universitat de Barcelona' },
      { sigla: 'GO', nom: 'GRECS / OACU' },
    ],
  },
  {
    slug: 'banys-d-arles',
    categoria: 'Comunicació',
    periode: '2023',
    titol: 'Els Banys d’Arles',
    subtitol: 'Comunicació institucional de l’Ajuntament',
    competencies: ['Comunicació institucional', 'Reorganització de servei', 'Traducció CA–FR'],
    entitats: [{ sigla: 'BA', nom: 'Ajuntament dels Banys d’Arles i Palaldà' }],
  },
  {
    slug: 'movokeur',
    categoria: 'Recerca',
    periode: '2013 — 2017',
    titol: 'MOVOKEUR',
    subtitol: 'Quatre anys d’assistència a la recerca',
    competencies: ['Entrevistes de camp', 'Publicació científica', 'Coordinació de socis'],
    entitats: [
      { sigla: 'MEC', nom: 'Ministerio de Educación y Cultura' },
      { sigla: 'AIW', nom: 'Antipode International Workshop Award 2015' },
    ],
  },
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Prototip · targetes de cas, v5</title>
  </head>
  <body>
    <header class="intro">
      <p class="kicker">Prototip llençable · v5</p>
      <h1>La trajectòria, del present cap enrere</h1>
      <p class="lead">
        El carril arrenca amb el més recent i va cap enrere a mesura que avances a la dreta. En
        repòs el títol és groc; la fitxa que mires el passa a blanc i obre el detall.
      </p>
    </header>

    <div class="carril">
      <ol class="pista" id="pista">
        {
          targetes.map((t) => (
            <li class="cas">
              <span class="osca" aria-hidden="true" />
              <p class="periode nums">{t.periode}</p>

              <h2 class="titol">{t.titol}</h2>

              <div class="relleu">
                <div class="repos">
                  <p class="subtitol">{t.subtitol}</p>
                  <p class="familia">{t.categoria}</p>
                </div>

                <div class="detall">
                  <ul class="competencies">
                    {t.competencies.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>

                  <div class="tanca">
                    <ul class="entitats">
                      {t.entitats.map((e) => (
                        <li>
                          <abbr title={e.nom}>{e.sigla}</abbr>
                        </li>
                      ))}
                    </ul>
                    <a
                      class="entrada"
                      href={`/ca/casos/${t.slug}/`}
                      aria-label={`${t.categoria}: obre el cas ${t.titol}`}
                    >
                      {t.categoria}
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="rems">
        <button type="button" class="rem" data-dir="-1" aria-label="Casos més recents">←</button>
        <button type="button" class="rem" data-dir="1" aria-label="Casos més antics">→</button>
      </div>
    </div>

    <script>
      /*
       * El carril es finit: les fletxes desplacen d'una fitxa i s'inhabiliten
       * als extrems. Sense aixo, un carril que ja no es mou sembla espatllat en
       * lloc d'acabat.
       */
      const pista = document.getElementById('pista');

      if (pista) {
        const suau = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const rems = [...document.querySelectorAll<HTMLButtonElement>('.rem')];

        const estat = () => {
          const marge = 2; // el desplacament subpixel no ha de bloquejar el boto
          for (const boto of rems) {
            const cap = Number(boto.dataset.dir);
            boto.disabled =
              cap < 0
                ? pista.scrollLeft <= marge
                : pista.scrollLeft >= pista.scrollWidth - pista.clientWidth - marge;
          }
        };

        estat();
        pista.addEventListener('scroll', estat, { passive: true });
        window.addEventListener('resize', estat);

        for (const boto of rems) {
          boto.addEventListener('click', () => {
            const fitxa = pista.querySelector('.cas');
            const pas = fitxa ? fitxa.getBoundingClientRect().width + 24 : 320;
            pista.scrollBy({
              left: pas * Number(boto.dataset.dir),
              behavior: suau ? 'smooth' : 'auto',
            });
          });
        }

        // El focus per teclat ha de portar la fitxa a la vista: sense aixo, el
        // tabulador obre una fitxa que es fora de pantalla.
        for (const enllac of pista.querySelectorAll('.entrada')) {
          enllac.addEventListener('focus', () => {
            enllac.closest('.cas')?.scrollIntoView({
              behavior: suau ? 'smooth' : 'auto',
              block: 'nearest',
              inline: 'center',
            });
          });
        }
      }
    </script>

    <style>
      /* Senyera aclarida el minim per aguantar sobre negre: 4,98:1, per damunt
         del 4,5:1 que demana el cos petit. El #DA121A pla es queda a 4,07:1. */
      :root {
        --vermell: #e33b32;
        --pas: var(--space-6);
      }

      body {
        padding: var(--space-16) 0 var(--space-24);
        overflow-x: hidden;
      }

      .intro {
        max-width: var(--measure-lead);
        margin: 0 auto var(--space-16);
        padding: 0 var(--gutter);
      }

      @media (min-width: 62rem) {
        .intro {
          max-width: calc(var(--measure-lead) + 2 * var(--gutter));
          margin-left: max(var(--gutter), (100vw - var(--content)) / 2);
          margin-right: 0;
          padding-left: 0;
        }
      }

      .kicker {
        font-family: var(--font-ui);
        font-size: var(--step--1);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-bottom: var(--space-3);
      }

      .lead {
        color: var(--ink-soft);
        margin-top: var(--space-4);
      }

      /* El carril ocupa tota l'amplada: es el que li dona el caracter de cinta,
         i el que fa que el tall de la dreta es llegeixi com «aixo continua». */
      .pista {
        list-style: none;
        margin: 0;
        padding: var(--space-8) var(--gutter) var(--space-12);
        display: flex;
        align-items: stretch;
        gap: var(--pas);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: thin;
        scrollbar-color: var(--rule) transparent;
      }

      .cas {
        position: relative;
        flex: 0 0 auto;
        width: 19rem;
        min-height: 24rem;
        display: flex;
        flex-direction: column;
        padding: var(--space-6);
        border: 1px solid var(--rule);
        background: var(--paper);
        transition:
          width var(--dur-slow) var(--ease-out),
          transform var(--dur-base) var(--ease-out),
          opacity var(--dur-base) var(--ease-out),
          border-color var(--dur-base) var(--ease-out),
          background var(--dur-base) var(--ease-out);
      }

      @media (min-width: 62rem) {
        .cas {
          width: 17rem;
        }

        .pista:hover .cas,
        .pista:focus-within .cas {
          width: 15rem;
          opacity: 0.55;
        }

        .pista:hover .cas:hover,
        .pista:focus-within .cas:focus-within {
          width: 26rem;
          opacity: 1;
        }
      }

      .cas:hover,
      .cas:focus-within {
        transform: translateY(-6px);
        background: var(--paper-sunk);
        border-color: color-mix(in oklab, var(--vermell) 40%, var(--rule));
      }

      /* La cronologia travessa totes les fitxes a la mateixa alcada i salta el
         buit entre l'una i l'altra. Va dins de cada fitxa: amb amplades que
         canvien, una linia absoluta s'hauria de recalcular amb JS. */
      .cas::before {
        content: '';
        position: absolute;
        top: 3.6rem;
        left: 0;
        right: calc(-1 * var(--pas) - 1px);
        height: 1px;
        background: var(--rule);
      }

      /* L'ultima fitxa es el final de la trajectoria: la linia s'hi atura en
         lloc de sortir cap al buit. */
      .cas:last-child::before {
        right: 0;
      }

      .osca {
        position: absolute;
        top: calc(3.6rem - 3px);
        left: var(--space-6);
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--ink-faint);
        transition:
          background var(--dur-base) var(--ease-out),
          transform var(--dur-base) var(--ease-out);
      }

      .cas:hover .osca,
      .cas:focus-within .osca {
        background: var(--vermell);
        transform: scale(1.6);
      }

      .periode {
        font-family: var(--font-ui);
        font-size: var(--step--1);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-bottom: var(--space-8);
        transition: color var(--dur-base) var(--ease-out);
      }

      .cas:hover .periode,
      .cas:focus-within .periode {
        color: var(--vermell);
      }

      /* Groc el que dorm, blanc el que mires. Amb els dos encesos alhora la
         fitxa activa no guanyava res. */
      .titol {
        font-size: var(--step-2);
        max-width: 18ch;
        color: var(--accent);
        transition: color var(--dur-base) var(--ease-out);
      }

      .cas:hover .titol,
      .cas:focus-within .titol {
        color: var(--ink);
      }

      .relleu {
        display: grid;
        margin-top: auto;
        padding-top: var(--space-6);
      }

      /* Els dos blocs s'ancoren al cantell de baix: el detall es mes alt i es
         qui fixa l'alcada de la cel·la, i sense l'ancora l'etiqueta de
         categoria surava per damunt del cul de la fitxa. */
      .repos,
      .detall {
        grid-area: 1 / 1;
        align-self: end;
        transition:
          opacity var(--dur-base) var(--ease-out),
          transform var(--dur-base) var(--ease-out);
      }

      /*
       * `pointer-events: none` al repos i `z-index` al detall: els dos blocs
       * comparteixen cel·la, i el repos amagat (`opacity: 0`) obre context
       * d'apilament mentre que el detall obert no en te cap. Per l'ordre de
       * pintat, el bloc invisible quedava per damunt i s'empassava el cursor
       * abans que arribes al boto. El repos no te res per clicar: que no rebi
       * mai cap esdeveniment es el que toca.
       */
      .repos {
        pointer-events: none;
      }

      .detall {
        position: relative;
        z-index: 1;
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
      }

      .cas:hover .repos,
      .cas:focus-within .repos {
        opacity: 0;
        transform: translateY(-8px);
      }

      .cas:hover .detall,
      .cas:focus-within .detall {
        opacity: 1;
        transform: none;
        pointer-events: auto;
      }

      .subtitol {
        color: var(--ink-soft);
        max-width: 30ch;
      }

      .familia {
        margin-top: var(--space-6);
        font-family: var(--font-ui);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }

      /* Nomes el nom de la competencia: qualsevol graduacio es llegeix com un
         examen. El filet vermell es ritme, no mesura: totes fan igual. */
      .competencies {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: var(--space-3);
        font-family: var(--font-ui);
        font-size: var(--step--1);
        color: var(--ink);
      }

      .competencies li {
        display: flex;
        align-items: baseline;
        gap: var(--space-3);
        white-space: nowrap;
      }

      .competencies li::before {
        content: '';
        flex: 0 0 auto;
        width: 1rem;
        height: 2px;
        background: var(--vermell);
        transform: translateY(-0.25em);
      }

      .tanca {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        margin-top: var(--space-8);
      }

      .entitats {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      /* Sigles encavalcades: mateixa figura que els avatars de l'original,
         pero amb el que hi ha darrere de l'encarrec. Marcador de posicio:
         quan hi hagi logotips, aquest cercle els acull igual. */
      .entitats li + li {
        margin-left: -0.5rem;
      }

      .entitats abbr {
        display: grid;
        place-items: center;
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 50%;
        border: 1px solid var(--rule);
        background: var(--paper);
        box-shadow: 0 0 0 2px var(--paper-sunk);
        font-family: var(--font-ui);
        font-size: 0.64rem;
        font-weight: var(--w-semibold);
        color: var(--ink-soft);
        text-decoration: none;
        cursor: help;
      }

      /* El boto diu la categoria. Contorn buit perque es vegi que hi ha boto, i
         s'omple de blanc quan hi tens el cursor a sobre. Cantells rectes: el
         lloc no te ni una vora arrodonida fora dels cercles de les sigles. */
      .entrada {
        padding: 0.5rem 0.9rem;
        border: 1px solid var(--ink);
        color: var(--ink);
        font-family: var(--font-ui);
        font-size: 0.72rem;
        font-weight: var(--w-medium);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        transition:
          background var(--dur-fast) var(--ease-out),
          color var(--dur-fast) var(--ease-out);
      }

      .entrada:hover {
        background: var(--ink);
        color: var(--paper);
      }

      .entrada:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .rems {
        display: flex;
        justify-content: center;
        gap: var(--space-3);
        margin-top: var(--space-4);
      }

      .rem {
        width: 2.6rem;
        height: 2.6rem;
        display: grid;
        place-items: center;
        border: 1px solid var(--rule);
        background: transparent;
        color: var(--ink-soft);
        font-family: var(--font-ui);
        font-size: var(--step-0);
        cursor: pointer;
        transition:
          color var(--dur-fast) var(--ease-out),
          border-color var(--dur-fast) var(--ease-out),
          opacity var(--dur-fast) var(--ease-out);
      }

      .rem:hover:not(:disabled) {
        color: var(--vermell);
        border-color: var(--vermell);
      }

      .rem:disabled {
        opacity: 0.3;
        cursor: default;
      }

      .rem:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* Sense `hover` el gest no existeix: el detall es queda obert i la fitxa
         creix el que calgui. El carril continua sent un carril: es desplaca amb
         el dit. */
      @media (hover: none) {
        .cas {
          width: 82vw;
          max-width: 22rem;
          min-height: 0;
        }

        .relleu {
          display: block;
        }

        .repos {
          display: none;
        }

        .detall {
          opacity: 1;
          transform: none;
          pointer-events: auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .cas,
        .osca,
        .periode,
        .titol,
        .repos,
        .detall,
        .entrada,
        .rem {
          transition: none;
        }
      }
    </style>
  </body>
</html>
