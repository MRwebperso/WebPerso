---
/**
 * Rutes mirall dels casos, costat català: `/ca/casos/<id>/`. El bessó francès
 * és `src/pages/fr/cas/[case].astro`, i el segment el tradueix el registre de
 * `src/i18n/utils.ts` (`casos` → `cas`). Els identificadors de cas no es
 * tradueixen, de manera que `hreflang` i el commutador de llengua surten sols.
 *
 * Embolcall fi, com les portades: tota la plantilla viu a CaseContent.astro.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseContent from '../../../components/CaseContent.astro';
import { site } from '../../../config/site.mjs';
import { getCaseRoutes, type CaseRouteProps } from '../../../data/cases';

export async function getStaticPaths() {
  return getCaseRoutes();
}

type Props = CaseRouteProps;

const { record, prev, next } = Astro.props;
const copy = record.copy.ca;
---

<BaseLayout lang="ca" title={`${copy.title} — ${site.name}`} description={copy.summary}>
  <CaseContent lang="ca" record={record} prev={prev} next={next} />
</BaseLayout>
