---
/**
 * Avís legal, costat català: `/ca/avis-legal/`. El bessó francès és
 * `src/pages/fr/mentions-legales.astro`, i el registre `segments` de
 * `src/i18n/utils.ts` (clau `legal`) els fa germans per al commutador de
 * llengua i les `hreflang`.
 *
 * Embolcall fi: la plantilla viu a LegalContent.astro i el text a data/legal.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import { site } from '../../config/site.mjs';
import { legal } from '../../data/legal';
---

<BaseLayout lang="ca" title={`${legal.ca.title} — ${site.name}`} description={legal.ca.description}>
  <LegalContent lang="ca" />
</BaseLayout>
