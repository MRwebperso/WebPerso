---
/**
 * «Targetes» v2 — prototip llencable, segona passada.
 *
 * Que canvia respecte de /targetes/ (v1), i per que:
 *
 * 1. Fora el neó. La v1 pintava un degradat radial saturat a l'angle de cada
 *    targeta i una pastilla plena de color: registre de tauler de producte, no
 *    el d'aquest lloc. Aqui la superficie es plana, el filet es d'1 px i l'unic
 *    color que s'encen en interactuar es el groc de l'accent, com a
 *    `Cases.astro`. La familia de feina es una banda de 2 px al cantell de
 *    dalt, amb tints de croma baixa que sobre negre es llegeixen com a grafit
 *    tenyit. Els tints NO toquen mai text: nomes filet i osques, on el minim
 *    exigible es 3:1 i no 4,5:1. L'etiqueta de familia va en `--ink-faint`.
 *
 * 2. Fora l'amuntegament. En repos la targeta diu quatre coses: periode,
 *    titol curt, una linia de subtitol i la familia. Les competencies, les
 *    entitats i l'entrada al cas viuen en una capa que puja des del cantell de
 *    baix en passar-hi per sobre o en rebre el focus. Puja per damunt, no
 *    empeny: la graella no es mou i les targetes veines no ballen.
 *
 *    On no hi ha `hover` (tactil), la capa es queda visible sempre: amagar
 *    darrere d'un gest que no existeix es perdre el contingut.
 *
 * Ruta fora de la navegacio i de l'i18n, catala nomes, `noindex`, per
 * esborrar. Carrega `theme-dark.css` perque la seccio de casos es fosca.
 */
import '../styles/base.css';
import '../styles/theme-dark.css';

type Nivell = 'puntual' | 'sostingut' | 'nucli';

const pes: Record<Nivell, { osques: number; text: string }> = {
  puntual: { osques: 2, text: 'puntual' },
  sostingut: { osques: 4, text: 'sostingut' },
  nucli: { osques: 5, text: 'nucli' },
};

/* Tints de croma baixa. Sobre `--paper` (#0a0a0a) tots passen de 4:1, molt per
   damunt del 3:1 que demana un element grafic. */
const families = {
  territori: { nom: 'Territori', color: '#7d8b68' },
  marca: { nom: 'Marca', color: '#8a7d95' },
  codi: { nom: 'Codi i IA', color: '#5f8b81' },
  comunicacio: { nom: 'Comunicació', color: '#9a8354' },
  recerca: { nom: 'Recerca', color: '#6f8194' },
} as const;

type Targeta = {
  slug: string;
  familia: keyof typeof families;
  periode: string;
  titol: string;
  subtitol: string;
  competencies: { nom: string; nivell: Nivell }[];
  entitats: { sigla: string; nom: string }[];
  minuts: number;
};

const targetes: Targeta[] = [
  {
    slug: 'agencia-atractivitat',
    familia: 'territori',
    periode: '2023 — 2025',
    titol: 'Una destinació de frontera',
    subtitol: 'Alt Vallespir, en quatre llengües',
    competencies: [
      { nom: 'Estratègia de destinació', nivell: 'nucli' },
      { nom: 'Disseny de visuals', nivell: 'sostingut' },
      { nom: 'Edició de xarxes', nivell: 'sostingut' },
    ],
    entitats: [
      { sigla: 'OT', nom: 'Oficina de Turisme de Prats de Molló' },
      { sigla: 'AA', nom: 'Agència d’Atractivitat de l’Alt Vallespir' },
    ],
    minuts: 5,
  },
  {
    slug: 'mar-i-muntanya',
    familia: 'marca',
    periode: '2026',
    titol: 'Mar i Muntanya, a Taula!',
    subtitol: 'Marca i web bilingüe',
    competencies: [
      { nom: 'Identitat de marca', nivell: 'nucli' },
      { nom: 'Web amb CMS', nivell: 'sostingut' },
      { nom: 'Redacció de dossiers', nivell: 'nucli' },
    ],
    entitats: [
      { sigla: 'CLM', nom: 'Cultures, Llengües i Memòries del Vallespir' },
      { sigla: 'ST', nom: 'Som Turisme (Alt Empordà)' },
    ],
    minuts: 6,
  },
  {
    slug: 'que-fas',
    familia: 'codi',
    periode: '2026 — avui',
    titol: '«Què fas?»',
    subtitol: 'L’agenda cultural de Catalunya Nord',
    competencies: [
      { nom: 'Web sense framework', nivell: 'nucli' },
      { nom: 'Extracció amb IA', nivell: 'sostingut' },
      { nom: 'Curadoria editorial', nivell: 'sostingut' },
    ],
    entitats: [{ sigla: 'CLM', nom: 'Cultures, Llengües i Memòries del Vallespir' }],
    minuts: 5,
  },
  {
    slug: 'banys-d-arles',
    familia: 'comunicacio',
    periode: '2023',
    titol: 'Els Banys d’Arles',
    subtitol: 'Tres mesos i un servei per endreçar',
    competencies: [
      { nom: 'Comunicació institucional', nivell: 'nucli' },
      { nom: 'Reorganització de servei', nivell: 'sostingut' },
      { nom: 'Traducció CA–FR', nivell: 'puntual' },
    ],
    entitats: [{ sigla: 'BA', nom: 'Ajuntament dels Banys d’Arles i Palaldà' }],
    minuts: 4,
  },
  {
    slug: 'grecs-oacu',
    familia: 'recerca',
    periode: '2020 — 2024',
    titol: 'Recerca associada a la UB',
    subtitol: 'Seminaris i un terreny a Suïssa',
    competencies: [
      { nom: 'Etnografia de camp', nivell: 'nucli' },
      { nom: 'Escriptura acadèmica', nivell: 'sostingut' },
      { nom: 'Treball en grup', nivell: 'sostingut' },
    ],
    entitats: [
      { sigla: 'UB', nom: 'Universitat de Barcelona' },
      { sigla: 'GO', nom: 'GRECS / OACU' },
    ],
    minuts: 5,
  },
  {
    slug: 'movokeur',
    familia: 'recerca',
    periode: '2013 — 2017',
    titol: 'MOVOKEUR',
    subtitol: 'Quatre anys d’assistència a la recerca',
    competencies: [
      { nom: 'Entrevistes de camp', nivell: 'nucli' },
      { nom: 'Publicació científica', nivell: 'sostingut' },
      { nom: 'Coordinació de socis', nivell: 'sostingut' },
    ],
    entitats: [
      { sigla: 'MEC', nom: 'Ministerio de Educación y Cultura' },
      { sigla: 'AIW', nom: 'Antipode International Workshop Award 2015' },
    ],
    minuts: 6,
  },
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Prototip · targetes de cas, v2</title>
  </head>
  <body>
    <main class="full">
      <header class="intro">
        <p class="kicker">Prototip llençable · v2</p>
        <h1>Targetes de cas</h1>
        <p class="lead">
          Superfície plana i un sol color que s’encén, com a la resta del lloc. En repòs, la
          targeta diu quatre coses; el detall puja del cantell de baix en passar-hi per sobre o
          en arribar-hi amb el tabulador.
        </p>
        <ul class="llegenda">
          {
            Object.values(families).map((f) => (
              <li><span style={`--c:${f.color}`}></span>{f.nom}</li>
            ))
          }
        </ul>
      </header>

      <ol class="graella">
        {
          targetes.map((t) => (
            <li class="targeta" style={`--c: ${families[t.familia].color}`}>
              <div class="repos">
                <p class="periode">{t.periode}</p>
                <h2 class="titol">
                  <a href={`/ca/casos/${t.slug}/`}>{t.titol}</a>
                </h2>
                <p class="subtitol">{t.subtitol}</p>
                <p class="familia">{families[t.familia].nom}</p>
              </div>

              <div class="detall">
                <p class="rubrica">Pes dins de l’encàrrec</p>
                <ul class="competencies">
                  {t.competencies.map((c) => (
                    <li>
                      <span class="nom">{c.nom}</span>
                      <span class="osques" role="img" aria-label={`${c.nom}: ${pes[c.nivell].text}`}>
                        {[1, 2, 3, 4, 5].map((i) => (
                          <i class={i <= pes[c.nivell].osques ? 'plena' : ''} />
                        ))}
                      </span>
                      <span class="nivell">{pes[c.nivell].text}</span>
                    </li>
                  ))}
                </ul>

                <div class="tanca">
                  <ul class="entitats">
                    {t.entitats.map((e) => (
                      <li><abbr title={e.nom}>{e.sigla}</abbr></li>
                    ))}
                  </ul>
                  <p class="entrada" aria-hidden="true">Obre el cas · {t.minuts} min</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </main>

    <style>
      body {
        padding: var(--space-16) var(--gutter) var(--space-24);
      }

      .full {
        max-width: var(--content);
        margin: 0 auto;
      }

      .intro {
        max-width: var(--measure-lead);
        margin-bottom: var(--space-16);
      }

      .kicker {
        font-family: var(--font-ui);
        font-size: var(--step--1);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-bottom: var(--space-3);
      }

      .lead {
        color: var(--ink-soft);
        margin-top: var(--space-4);
      }

      .llegenda {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-6);
        list-style: none;
        padding: 0;
        margin: var(--space-8) 0 0;
        font-family: var(--font-ui);
        font-size: var(--step--1);
        color: var(--ink-faint);
      }

      .llegenda li {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }

      .llegenda span {
        width: 1.4rem;
        height: 2px;
        background: var(--c);
      }

      .graella {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
        gap: var(--space-8);
      }

      /*
       * Sense radi ni ombra: la resta del lloc treballa amb filets, i una
       * targeta arrodonida amb ombra hi entraria com una peca d'un altre joc.
       * La banda de familia va al cantell de dalt, que es on `Cases.astro` ja
       * posa el filet que obre cada fitxa.
       */
      .targeta {
        position: relative;
        overflow: hidden;
        /* 24rem: la capa de detall fa 235 px i el titol mes llarg baixa fins als
           129 px. Amb aquesta alcada, la capa oberta encara deixa veure el
           periode i el titol sencers, amb un dit de marge. */
        min-height: 24rem;
        display: flex;
        flex-direction: column;
        border: 1px solid var(--rule);
        border-top: 2px solid var(--c);
        background: var(--paper);
        transition:
          background var(--dur-base) var(--ease-out),
          border-color var(--dur-base) var(--ease-out);
      }

      .targeta:hover,
      .targeta:focus-within {
        background: var(--paper-sunk);
      }

      .repos {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: var(--space-6);
      }

      .periode {
        font-family: var(--font-ui);
        font-size: var(--step--1);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--ink-faint);
        font-variant-numeric: tabular-nums;
      }

      .titol {
        margin-top: var(--space-4);
        font-size: var(--step-2);
        max-width: 18ch;
      }

      .titol a {
        text-decoration: none;
        transition: color var(--dur-base) var(--ease-out);
      }

      /* Tota la targeta es clicable amb un sol enllac, el del titol: mateixa
         solucio que `Cases.astro`, amb la mateixa contrapartida (la capa tapa
         el text i no es pot seleccionar amb el ratoli). */
      .titol a::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 2;
      }

      .targeta:hover .titol a,
      .targeta:focus-within .titol a {
        color: var(--accent);
      }

      .subtitol {
        margin-top: var(--space-2);
        color: var(--ink-soft);
        max-width: 32ch;
        transition: opacity var(--dur-base) var(--ease-out);
      }

      /* Amb la capa oberta, el periode i el titol han de continuar llegibles:
         el que marxa es el que la capa ja repeteix d'una altra manera. */
      .targeta:hover .subtitol,
      .targeta:focus-within .subtitol,
      .targeta:hover .familia,
      .targeta:focus-within .familia {
        opacity: 0;
      }

      .familia {
        margin-top: auto;
        padding-top: var(--space-6);
        font-family: var(--font-ui);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-faint);
        transition: opacity var(--dur-base) var(--ease-out);
      }

      /*
       * La capa de detall puja per damunt en lloc d'empenyer: si creixes
       * l'alcada, les targetes de la mateixa fila es desplacarien i el cursor
       * perseguiria la que acaba de moure's.
       */
      .detall {
        position: absolute;
        inset: auto 0 0 0;
        z-index: 1;
        padding: var(--space-4) var(--space-6) var(--space-6);
        background: var(--paper-sunk);
        border-top: 1px solid var(--rule);
        transform: translateY(101%);
        transition: transform var(--dur-base) var(--ease-out);
      }

      .targeta:hover .detall,
      .targeta:focus-within .detall {
        transform: translateY(0);
      }

      .rubrica {
        font-family: var(--font-ui);
        font-size: 0.72rem;
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--ink-faint);
      }

      .competencies {
        list-style: none;
        padding: 0;
        margin: var(--space-3) 0 0;
        display: grid;
        gap: var(--space-2);
      }

      .competencies li {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-areas:
          'nom nivell'
          'osques osques';
        gap: var(--space-1) var(--space-4);
        align-items: baseline;
        font-family: var(--font-ui);
        font-size: var(--step--1);
      }

      .nom {
        grid-area: nom;
        color: var(--ink);
      }

      .nivell {
        grid-area: nivell;
        color: var(--ink-faint);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      /* Cinc osques i no una barra continua: una barra continua es llegeix com
         un percentatge, que es exactament el que s'ha d'evitar. */
      .osques {
        grid-area: osques;
        display: flex;
        gap: 3px;
      }

      .osques i {
        height: 3px;
        flex: 1;
        background: var(--rule);
      }

      .osques i.plena {
        background: var(--c);
      }

      .tanca {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        margin-top: var(--space-4);
        padding-top: var(--space-3);
        border-top: 1px solid var(--rule);
      }

      .entitats {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      /* Sigles encavalcades: mateixa figura que els avatars de l'original,
         pero amb el que hi ha darrere de l'encarrec. Marcador de posicio:
         quan hi hagi logotips, aquest cercle els acull igual. */
      .entitats li + li {
        margin-left: -0.5rem;
      }

      .entitats abbr {
        display: grid;
        place-items: center;
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 50%;
        border: 1px solid var(--rule);
        background: var(--paper);
        box-shadow: 0 0 0 2px var(--paper-sunk);
        font-family: var(--font-ui);
        font-size: 0.64rem;
        font-weight: var(--w-semibold);
        color: var(--ink-soft);
        text-decoration: none;
        cursor: help;
      }

      /* Sense pastilla plena: l'entrada es la mateixa formula de `Cases.astro`
         —text tenue que passa a groc amb la fletxa que avanca—, i aixi la
         targeta no obre cap registre nou. */
      .entrada {
        font-family: var(--font-ui);
        font-size: var(--step--1);
        color: var(--ink-faint);
        white-space: nowrap;
        transition: color var(--dur-base) var(--ease-out);
      }

      .entrada::after {
        content: '\2009→';
        display: inline-block;
        transition: transform var(--dur-base) var(--ease-out);
      }

      .targeta:hover .entrada,
      .targeta:focus-within .entrada {
        color: var(--accent);
      }

      .targeta:hover .entrada::after,
      .targeta:focus-within .entrada::after {
        transform: translateX(0.25rem);
      }

      .targeta:has(a:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }

      .titol a:focus-visible {
        outline: none;
      }

      /* Sense `hover` el gest no existeix: la capa es queda oberta i la
         targeta creix el que calgui. */
      @media (hover: none) {
        .detall {
          position: static;
          transform: none;
        }

        .targeta {
          min-height: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .detall,
        .subtitol,
        .familia,
        .entrada,
        .entrada::after,
        .titol a,
        .targeta {
          transition: none;
        }
      }
    </style>
  </body>
</html>
